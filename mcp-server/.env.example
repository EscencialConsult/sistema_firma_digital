# Servidor MCP — Firma Electrónica (SOLO uso local, SOLO SUPER_ADMIN)
#
# Copiá este archivo a ".env" y completá con las credenciales reales del
# proyecto Supabase. NUNCA commitear el .env real — la service_role key
# tiene acceso total a la base de datos y bypassea todas las políticas RLS.

SUPABASE_URL=https://tu-proyecto.supabase.co

# NUNCA commitear el .env real — esta key tiene acceso total, bypassea RLS.
SUPABASE_SERVICE_ROLE_KEY=
